# Frontend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# API URL - Backend Laravel API base URL
VITE_API_URL=http://localhost:8000/api

# Midtrans Configuration
# Set to 'true' for production, 'false' for sandbox
VITE_MIDTRANS_IS_PRODUCTION=false

# Get your client key from https://dashboard.midtrans.com/
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key-here

# Enable mock payment bypass for local development (no real Midtrans credentials needed)
# NEVER set this to 'true' in production!
VITE_ENABLE_PAYMENT_MOCK=true
